# ─── Meu Pluggy (plano pessoal, gratuito) ───
# Credenciais em https://meu.pluggy.ai → Dashboard
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# itemId de cada banco conectado, separados por vírgula (copiar do painel do
# Meu Pluggy). Necessário porque LISTAR itens pela API é recurso de plano pago.
PLUGGY_ITEM_IDS=

# ─── Banco ───
DATABASE_URL=

# ─── Painel (usuário único) ───
# hash da senha, nunca a senha em texto
APP_PASSWORD_HASH=

# ─── Ingestão pelo app Atalhos (iOS) ───
# bearer token estático, rotacionável; vai no header, nunca na URL
INGEST_TOKEN=

# ─── Web Push (VAPID) ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
